@if (ConfiguracionApi.UrlArchivo(Foto) is { } url)
{
    <img class="avatar" src="@url" alt="@Nombre" style="width:@(Tamano)px;height:@(Tamano)px" />
}
else
{
    <span class="avatar" style="width:@(Tamano)px;height:@(Tamano)px;font-size:@(Tamano / 2.6)px">@Iniciales</span>
}

@code {
    [Parameter, EditorRequired] public string Nombre { get; set; } = string.Empty;

    [Parameter] public string? Foto { get; set; }

    [Parameter] public int Tamano { get; set; } = 40;

    private string Iniciales => string.Concat(Nombre
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(parte => char.ToUpperInvariant(parte[0])));
}

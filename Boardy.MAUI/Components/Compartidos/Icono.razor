@* Íconos SVG de trazo simple, sin depender de una fuente de íconos. *@
<svg width="@Tamano" height="@Tamano" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Nombre)
    {
        case "inicio":
            <path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z" />
            break;
        case "campana":
            <path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0" />
            break;
        case "usuario":
            <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case "escudo":
            <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" />
            break;
        case "volver":
            <path d="M19 12H5" /><path d="m12 19-7-7 7-7" />
            break;
        case "mas":
            <path d="M12 5v14" /><path d="M5 12h14" />
            break;
        case "editar":
            <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
            break;
        case "basura":
            <path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" />
            break;
        case "equipo":
            <circle cx="9" cy="8" r="3.5" /><path d="M2 20a7 7 0 0 1 14 0" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7" /><path d="M18 14a7 7 0 0 1 4 6" />
            break;
        case "etiqueta":
            <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z" /><circle cx="7.5" cy="7.5" r="1.5" />
            break;
        case "buscar":
            <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Nombre { get; set; } = string.Empty;

    [Parameter] public int Tamano { get; set; } = 22;
}

@typeparam TRegistro
@* Lista con botón "Ver más": la usan la auditoría y el log de errores. *@

@foreach (var registro in Registros)
{
    @Fila(registro)
}

@if (Cargando)
{
    <div class="cargando"><div class="spinner-border text-primary"></div></div>
}
else if (Registros.Count == 0)
{
    <p class="vacio">@TextoVacio</p>
}
else if (Registros.Count < Total)
{
    <button class="btn btn-outline-light w-100" @onclick="AlPedirMas">Ver más (@Registros.Count de @Total)</button>
}

@code {
    [Parameter, EditorRequired] public List<TRegistro> Registros { get; set; } = new();

    [Parameter, EditorRequired] public RenderFragment<TRegistro> Fila { get; set; } = null!;

    [Parameter] public int Total { get; set; }

    [Parameter] public bool Cargando { get; set; }

    [Parameter] public string TextoVacio { get; set; } = string.Empty;

    [Parameter] public EventCallback AlPedirMas { get; set; }
}

@inherits LayoutComponentBase
@implements IDisposable
@inject SesionServicio Sesion
@inject NavigationManager Navegacion

@if (Sesion.Activa)
{
    <div class="app">
        @Body
    </div>

    <BarraInferior />
}

@code {
    protected override void OnInitialized()
    {
        Sesion.Cambio += AlCambiarSesion;
        RedirigirSiNoHaySesion();
    }

    private void AlCambiarSesion()
    {
        RedirigirSiNoHaySesion();
        InvokeAsync(StateHasChanged);
    }

    // Toda pantalla con este layout requiere sesión iniciada.
    private void RedirigirSiNoHaySesion()
    {
        if (!Sesion.Activa)
        {
            Navegacion.NavigateTo("login", replace: true);
        }
    }

    public void Dispose() => Sesion.Cambio -= AlCambiarSesion;
}

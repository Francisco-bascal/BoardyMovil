@page "/tableros/{TableroId:int}/listas/nueva"
@page "/tableros/{TableroId:int}/listas/{ListaTareaId:int}/editar"
@inject TableroServicio TableroServicio
@inject NavigationManager Navegacion
@inject DialogoServicio Dialogo

<Encabezado Titulo="@(EsNueva ? "Nueva lista" : "Editar lista")" Volver="@($"tableros/{TableroId}")" />

<EditForm Model="_modelo" OnValidSubmit="GuardarAsync">
    <DataAnnotationsValidator />
    <MensajeError Texto="@_error" />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText class="form-control" @bind-Value="_modelo.Nombre" />
        <ValidationMessage For="() => _modelo.Nombre" />
    </div>
    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <InputTextArea class="form-control" rows="2" @bind-Value="_modelo.Descripcion" />
    </div>

    @if (_esKanban)
    {
        <div class="mb-4">
            <label class="form-label">Estado de las tareas</label>
            <InputSelect class="form-select" @bind-Value="_modelo.EstadoTareaId">
                <option value="">Elegí un estado</option>
                @foreach (var estado in _estadosDisponibles)
                {
                    <option value="@estado.EstadoTareaId">@estado.Nombre</option>
                }
            </InputSelect>
            <div class="form-text text-muted">En Kanban cada lista representa un estado distinto.</div>
        </div>
    }

    <button class="btn btn-primary w-100" type="submit" disabled="@_enviando">Guardar</button>
</EditForm>

@if (!EsNueva)
{
    <button class="btn btn-outline-danger w-100 mt-3" @onclick="EliminarAsync" disabled="@_enviando">Eliminar lista</button>
}

@code {
    [Parameter] public int TableroId { get; set; }

    [Parameter] public int? ListaTareaId { get; set; }

    private ActualizarListaTareaDto _modelo = new();
    private List<EstadoTareaDto> _estadosDisponibles = new();
    private bool _esKanban;
    private string? _error;
    private bool _enviando;

    private bool EsNueva => ListaTareaId is null;

    protected override async Task OnInitializedAsync()
    {
        var tablero = await TableroServicio.ObtenerAsync(TableroId);
        var listas = await TableroServicio.ListarListasAsync(TableroId);
        _error = tablero.Error ?? listas.Error;
        _esKanban = tablero.Datos?.EsKanban == true;

        var lista = listas.Datos?.FirstOrDefault(l => l.ListaTareaId == ListaTareaId);
        if (lista is not null)
        {
            _modelo = new ActualizarListaTareaDto { Nombre = lista.Nombre, Descripcion = lista.Descripcion, EstadoTareaId = lista.EstadoTareaId };
        }

        if (_esKanban)
        {
            // Solo los estados sin lista, más el de la lista que se está editando.
            var estados = await TableroServicio.ListarEstadosAsync(TableroId);
            _estadosDisponibles = (estados.Datos ?? new())
                .Where(e => !listas.Datos!.Any(l => l.EstadoTareaId == e.EstadoTareaId && l.ListaTareaId != ListaTareaId))
                .ToList();
        }
    }

    private async Task GuardarAsync()
    {
        _enviando = true;
        var resultado = EsNueva
            ? await TableroServicio.CrearListaAsync(TableroId, _modelo)
            : await TableroServicio.ActualizarListaAsync(ListaTareaId!.Value, _modelo);
        _enviando = false;

        if (resultado.Exito)
        {
            Navegacion.NavigateTo($"tableros/{TableroId}", replace: true);
            return;
        }

        _error = resultado.Error;
    }

    private async Task EliminarAsync()
    {
        if (!await Dialogo.ConfirmarAsync("¿Eliminar la lista y todas sus tareas?", "Eliminar"))
        {
            return;
        }

        _enviando = true;
        var resultado = await TableroServicio.EliminarListaAsync(ListaTareaId!.Value);
        _enviando = false;

        if (resultado.Exito)
        {
            Navegacion.NavigateTo($"tableros/{TableroId}", replace: true);
            return;
        }

        _error = resultado.Error;
    }
}
